
/*
 * Using I2C1 - connected to APB1 bus - Enable clock access to APB1 bus
 * Go to Alternate function table in Datasheet
 * I2C SCL =PB8 =D15
 * I2C SDA =PB9 =D14
 *
 * Write init function  - comments inside function (I2C.c)
 * Write a function to read data
 */

#include <stdio.h>
#include "stm32f4xx.h"
#include <stdint.h>
#include "I2C.h"
#include "rtc.h"
#include "uart.h"

#define GPIOAEN		(1U<<0)
#define RTC_ADDR  	0x68
//#define LED_PIN		5

uint8_t sec, min, hour;

int main(void)
{
	/* Code to configure LED PIN PA5*/
		RCC->AHB1ENR |= GPIOAEN;
		GPIOA->MODER &= ~(1U << 10);
		GPIOA->MODER |=  (1U << 11); //PA5

		GPIOA->OTYPER &= ~(1U << 5); // push-pull
		GPIOA->PUPDR &= ~(3U << 10); // no pull-up/pull-down

		 I2C_init();
		 UART2_tx_init();

	RTC_SET_TIME(5,0,0);

   //char msg[] = "HELLO\r\n";

    while(1)
    {
    	 RTC_GET_TIME(&hour,&min,&sec);
    	 char msg[50];						//To store formatted time
    	 sprintf(msg,"%02d:%02d:%02d \r\n", hour, min, sec); //Time Format :sprintf converts to string

    	 for(int i = 0; msg[i] != '\0'; i++) //Now to display the time (as UART sends 1 char at a time, we need loop)
    	 {
            uart2_write(msg[i]);
    	 }

    	 // Blink LED at 05:00:00
    	  if(hour ==5 && min ==0 && sec ==0)
    	  {
    		  GPIOA->ODR |= (1U << 5);   // toggle LED
    	      //for(volatile int i = 0; i < 1000000; i++); // small delay so blink is visible
    	   }
    	  for(volatile int i=0; i<1000000; i++);		//delay

    }

}
