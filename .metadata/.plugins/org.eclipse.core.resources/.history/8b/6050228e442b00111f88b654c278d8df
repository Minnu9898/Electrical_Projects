 * Write a function to read data
 */

#include <stdio.h>
#include "stm32f4xx.h"
#include <stdint.h>
#include "I2C.h"
#include "rtc.h"
#include "uart.h"

#define GPIOAEN		(1U<<0)
#define RTC_ADDR  	0x68
//#define LED_PIN		5

uint8_t sec, min, hour;

int main(void)
{
	int main(void)
	{
	    // 1. Enable GPIOA clock
	    RCC->AHB1ENR |= GPIOAEN;

	    // 2. Set PA5 as output
	    GPIOA->MODER &= ~(3U << (LED_PIN*2)); // Clear mode bits
	    GPIOA->MODER |=  (1U << (LED_PIN*2)); // Set as output

	    // 3. Output type = push-pull
	    GPIOA->OTYPER &= ~(1U << LED_PIN);

	    // 4. No pull-up, no pull-down
	    GPIOA->PUPDR &= ~(3U << (LED_PIN*2));

	    while(1)
	    {
	        GPIOA->ODR ^= (1U << LED_PIN); // Toggle LED
	        for(volatile int i = 0; i < 500000; i++); // Delay
	    }
	}

}
