
/*
 * Find I2C address
 * Find register map
 */
#include "stm32f4xx.h"
#include "rtc.h"


#define RTC_ADDR  	0x68 // Slave address of  RTC( DS3231) =0110 1000 from data sheet

static uint8_t dec_to_bcd(uint8_t val)
{
    return ((val / 10) << 4) | (val % 10);
}

static uint8_t bcd_to_dec(uint8_t val)
{
	return ((val >> 4) * 10) + (val & 0x0F);
}

void RTC_SET_TIME(uint8_t hour, uint8_t min, uint8_t sec)
{
		uint8_t data[3];

	    data[0] = dec_to_bcd(sec);
	    data[1] = dec_to_bcd(min);
	    data[2] = dec_to_bcd(hour);

	    I2C1_Burst_write(RTC_ADDR, 0x00, 3, data);
}


void RTC_GET_TIME(uint8_t *hour, uint8_t *min, uint8_t *sec)
{
	uint8_t data[3];
	I2C1_Burst_read(RTC_ADDR,0x00,3, data);

	*sec =bcd_to_dec(data[0]& & 0x7F); // bit7 = CH (Clock Halt) for DS3231
	*min =bcd_to_dec(data[1]);
	*hour =bcd_to_dec(data[2] & 0x3F);			// Mask 12/24 and AM/PM bits
}


